# The public bucket the RML logical sources in this package read their Parquet
# objects from.
#
# No svdb:accessKeyId, and that absence is the declaration: a BlobConnection with
# no key id is an anonymous public bucket, reached over plain HTTP at
# svdb:endpoint with no credential, no keychain binding, and no consent gesture.
# There is no secret half to bind, so the descriptor raises no secret/unbound and
# offers no Bind lens.
#
# The named subject IRI below rather than a blank node is kept anyway: the
# destination pin and the test-connection verdict both key on it, and a blank node
# has no stable identity across a parse.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix svs:  <https://pkg.semvia.io/semvia/core/meta-schema#> .
@prefix svds: <https://pkg.semvia.io/semvia/core/dataset#> .
@prefix svdb: <https://pkg.semvia.io/semvia/rml/connection#> .
@prefix conn: <#> .

<> a svs:Schema ;
  dct:title "GLEIF Bucket Connection"@en ;
  dct:description "The anonymous svdb:BlobConnection this package's RML logical sources read their Parquet objects through: the public semvia-pkg bucket at pkg.semvia.io, rooted at this package's folder. Carries no credential, because a public bucket has none."@en ;
  # Absolute IRIs — a relative `<../…>` spelling would resolve against this
  # package's baseIRI and land on an IRI nothing publishes.
  svds:imports <https://pkg.semvia.io/semvia/core/meta-schema> ;
  svds:imports <https://pkg.semvia.io/semvia/rml/connection> ;
  sh:declare [
    a sh:PrefixDeclaration ;
    sh:prefix "conn" ;
    sh:namespace conn:
  ] ;
.

conn:pkg-semvia-io a svdb:BlobConnection ;
  rdfs:label "pkg.semvia.io (gleif)"@en ;
  rdfs:comment "The GLEIF golden copy as two Parquet objects in the public semvia-pkg bucket, served at https://pkg.semvia.io/semvia/gleif/@data/. The prefix roots every key at this package's folder, so a mapping names only `@data/<file>.parquet`."@en ;

  svdb:bucket "semvia-pkg" ;
  # R2 takes `auto`. The region is still required: the destination pin and the
  # display coordinate read it.
  svdb:region "auto" ;
  # The base URL of the public bucket. Required when svdb:accessKeyId is absent,
  # because an anonymous bucket is an HTTP object store and this is its root.
  svdb:endpoint "https://pkg.semvia.io" ;
  # A byte-prefix, not a path segment, so the folder writes its own trailing slash.
  svdb:prefix "semvia/gleif/" ;
.
