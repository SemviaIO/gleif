# The RelatedEntities mapping — GLEIF relationship rows read as typed parent
# edges on the child entity, rather than as reified relationship nodes.
#
# WHY TURTLE. Every map in this package is Turtle because its source is a
# Parquet object addressed by svdb:key, which the Markdown mapping surface does
# not route. This one would need Turtle regardless: the Markdown surface puts the
# predicate in the `###` heading, as a constant, and a discriminated predicate
# map needs `rml:reference` and `svrl:resolveVia` on the *predicate* side of the
# same block whose object side already claims `rml:template`. The heading
# grammar has no slot for that, and growing one would mean growing an expression
# layer into the `###` line, which the surface deliberately does not have.
#
# WHAT THE DISCRIMINATION BUYS. One relation, one scan, six predicates. The
# walker expands the predicate map below at mapping-load time into one
# constant-predicate object map per concept in the relationship-type scheme, each
# conditioned on `relationship_relationshiptype` holding that concept's notation
# — and the engine pushes that condition into the Parquet scan, so a query for
# `gleif:fundManagedBy` filters at the reader instead of marshalling all 482,824
# rows.

@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rml:   <http://w3id.org/rml/> .
@prefix svs:   <https://pkg.semvia.io/semvia/core/meta-schema#> .
@prefix svdb:  <https://pkg.semvia.io/semvia/rml/connection#> .
@prefix svcat: <https://pkg.semvia.io/semvia/rml/catalog#> .
@prefix svds:  <https://pkg.semvia.io/semvia/core/dataset#> .
@prefix svrl:  <https://pkg.semvia.io/semvia/rml/lookup#> .
@prefix : <#> .

<> a svs:Schema ;
  dct:title "GLEIF Related Entities Mapping"@en ;
  dct:description "The relationship golden copy read a second time as typed child-to-parent edges on the legal entity, with the edge chosen per row by the relationship_relationshiptype discriminator."@en ;
  svds:imports <https://pkg.semvia.io/semvia/core/meta-schema> ;
  svds:imports <https://pkg.semvia.io/semvia/rml/lookup> ;
  svds:imports <https://pkg.semvia.io/semvia/rml/connection> ;
  svds:imports <https://pkg.semvia.io/semvia/rml/catalog> ;
  svds:imports <./ontology> ;
  svds:imports <./relationship-types> ;
  svds:imports <./connection> ;
.

# Two TriplesMaps over one file is deliberate and supported — the federation
# engine keys a registered table on the TriplesMap's local name, not on the
# source, so this and `Relationships` register as two tables over the same
# Parquet object.
:RelatedEntities a rml:TriplesMap ;
  rdfs:label "RelatedEntities" ;
  rdfs:comment "The same relationship rows read as a direct child-to-parent edge. The subject is the child entity itself — the same IRI the LeiRecords map mints — so the edge lands on the legal entity rather than on a relationship node, and a closure query needs no reification hop."@en ;

  # The explicit `a rml:…` on each glue node below is not decoration: the RML
  # shapes check the node's type through `sh:class`, so omitting it is a
  # validation failure rather than a shorthand.
  rml:logicalSource [
    a rml:LogicalSource ;
    rml:source <connection#pkg-semvia-io> ;
    svdb:key "@data/relationship_records.parquet" ;
    svdb:format svdb:Parquet
  ] ;

  # Typing the subject as a legal entity here is not a second, weaker definition
  # of the class — it is the same entity, asserted from a second relation, and it
  # is true of every row: an endpoint of a GLEIF relationship record is by
  # construction an entity in the register.
  rml:subjectMap [
    a rml:SubjectMap ;
    rml:template "https://gleif.org/lei/{relationship_startnode_nodeid}" ;
    rml:class <ontology#LegalEntity>
  ] ;

  # The discriminated predicate map. `rml:reference` names the column whose value
  # decides the predicate; `svrl:resolveVia` names the lookup that turns that
  # value into a term. Neither side is a constant, and that is the whole point:
  # adding a seventh GLEIF relationship type is a concept in
  # relationship-types.ttl, not an edit here.
  rml:predicateObjectMap [
    a rml:PredicateObjectMap ;
    rml:predicateMap [
      a rml:PredicateMap ;
      rml:reference "relationship_relationshiptype" ;
      svrl:resolveVia <relationship-types#lookup>
    ] ;
    rml:objectMap [
      a rml:ObjectMap ;
      rml:template "https://gleif.org/lei/{relationship_endnode_nodeid}"
    ]
  ] ;

  # The same file as Relationships, so the same order: child first, then parent.
  # A closure climbing gleif:directlyConsolidatedBy+ binds the child, and every
  # edge out of one child sits in one run of rows.
  svcat:declaredSortOrder [
    a svcat:SortOrder ;
    svcat:sortKey [
      a svcat:SortKey ;
      svcat:sortColumnName "relationship_startnode_nodeid" ;
      svcat:ordinalPosition 1 ;
      svcat:sortDirection svcat:Ascending ;
      svcat:nullsPlacement svcat:NullsFirst
    ] ;
    svcat:sortKey [
      a svcat:SortKey ;
      svcat:sortColumnName "relationship_endnode_nodeid" ;
      svcat:ordinalPosition 2 ;
      svcat:sortDirection svcat:Ascending ;
      svcat:nullsPlacement svcat:NullsFirst
    ]
  ] ;
.
